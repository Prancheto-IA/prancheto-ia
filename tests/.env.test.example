# URL do projeto Supabase de dev (prancheto-ia-dev / jjvvzndhwxdcvbikoqce).
# E a mesma URL publica que ja esta em frontend/.env.development.
SUPABASE_URL=https://jjvvzndhwxdcvbikoqce.supabase.co

# Chave anon do mesmo projeto — tambem publica, mesma de frontend/.env.development.
SUPABASE_ANON_KEY=

# Chave service_role do projeto de DEV. Bypassa RLS por completo — e como ter
# acesso root ao banco. Pegue em: Supabase Dashboard > prancheto-ia-dev >
# Project Settings > API > "service_role" (a secreta, nao a "anon").
# NUNCA coloque isto num arquivo com prefixo VITE_, nunca no frontend/,
# nunca comite este valor.
SUPABASE_SERVICE_ROLE_KEY=
