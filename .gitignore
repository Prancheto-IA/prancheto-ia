# =============================================================
# PRANCHETO.IA - .gitignore
# Arquivos e pastas que NÃO devem ser versionados no Git.
# =============================================================

# --- Variáveis de ambiente (NUNCA commitar!) ---
# Exceção versionada: frontend/.env.example (template sem segredos)
.env
.env.local
.env.*.local
.env.development
.env.production
backend/.env
frontend/.env
frontend/.env.development
frontend/.env.production

# --- Credenciais de banco ---
.supabase-dev-db-password.txt
*.db-password.txt

# --- Supabase CLI (estado local) ---
supabase/.branches/
supabase/.temp/
supabase/.env

# --- Dependências Node.js ---
node_modules/
backend/node_modules/
frontend/node_modules/

# --- Build do frontend ---
frontend/dist/
frontend/dist-ssr/

# --- Logs ---
*.log
logs/
backend/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Cache do Vite ---
frontend/.vite/

# --- Cache do sistema operacional ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDEs e editores ---
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Cobertura de testes ---
coverage/
.nyc_output/

# --- Arquivos temporários ---
*.tmp
*.temp
