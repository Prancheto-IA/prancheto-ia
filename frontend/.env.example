# ==========================================================
# PRANCHETO.IA - Template de variaveis de ambiente
#
# Este e o UNICO arquivo .env versionado no git.
# Ele nao contem segredos: e apenas o modelo a ser copiado.
#
# Como usar:
#   cp .env.example .env.development   -> preencher com o Supabase de DEV
#   cp .env.example .env.production    -> preencher com o Supabase de PROD
#
# O Vite escolhe o arquivo automaticamente pelo modo:
#   npm run dev    -> .env.development
#   npm run build  -> .env.production
# ==========================================================

# URL do projeto Supabase (https://<ref>.supabase.co)
VITE_SUPABASE_URL=

# Chave publica (anon) do projeto Supabase.
# E segura para o browser: o isolamento real vem das policies de RLS.
VITE_SUPABASE_ANON_KEY=

# Nome exibido na interface. Mantenha o sufixo [DEV] fora de producao
# para que ninguem confunda os ambientes.
VITE_APP_NAME=Prancheto.IA [DEV]

# Ambiente logico: development | production
# Consumido por src/lib/supabase.js, main.jsx (Sentry) e useErrorHandler.js
VITE_APP_ENV=development

# --- Opcionais ---

# DSN do Sentry. Deixe vazio em desenvolvimento para nao poluir os alertas.
VITE_SENTRY_DSN=

# Valvula de escape: permite que um ambiente que nao seja producao
# aponte para o Supabase de producao. Mantenha DESLIGADO.
# So ative de forma temporaria e consciente para depurar um dado real.
# VITE_PERMITIR_PROD_EM_DEV=true
