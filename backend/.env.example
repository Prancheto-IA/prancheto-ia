# =============================================================
# PRANCHETO.IA - VARIÁVEIS DE AMBIENTE (EXEMPLO)
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env no repositório!
# =============================================================

# --- Servidor ---
NODE_ENV=development
PORT=3001

# --- Supabase (Banco de Dados) ---
# Obtenha em: https://supabase.com → Seu Projeto → Settings → API
# SUPABASE_URL: URL do projeto (ex: https://xyzxyzxyz.supabase.co)
SUPABASE_URL=https://seu-projeto.supabase.co

# SUPABASE_SERVICE_KEY: Service Role Key (NÃO use a anon key no backend!)
# Encontre em: Settings → API → service_role (secret)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...sua_service_role_key_aqui

# --- JWT (Autenticação) ---
# Gere uma chave segura com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=sua_chave_jwt_super_secreta_aqui
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=sua_chave_refresh_super_secreta_aqui
JWT_REFRESH_EXPIRES_IN=7d

# --- Super Admin (Conta Tronco) ---
# Criado automaticamente na primeira inicialização do servidor
SUPER_ADMIN_EMAIL=admin@prancheto.ia
SUPER_ADMIN_PASSWORD=SuaSenhaForteAqui@123
SUPER_ADMIN_NOME=Super Admin

# --- Sentry (Monitoramento de Erros) ---
# Obtenha em: https://sentry.io
# Deixe em branco para desativar o Sentry em desenvolvimento
SENTRY_DSN=

# --- OpenAI (Chat com IA) ---
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-sua_chave_openai_aqui

# Modelo padrão a ser utilizado no chat
# Opções: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini

# Limite máximo de tokens por resposta (controle de custo)
OPENAI_MAX_TOKENS=2048

# Temperatura da IA (0.0 = determinístico, 2.0 = muito criativo)
OPENAI_TEMPERATURE=0.7

# --- CORS ---
# URL do frontend (separar múltiplas URLs por vírgula)
CORS_ORIGIN=http://localhost:5173

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
